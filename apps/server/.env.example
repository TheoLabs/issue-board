# AWS RDS MySQL 접속 문자열
# 형식: mysql://<user>:<password>@<host>:3306/<database>
# 비밀번호에 @ : / 등 특수문자가 있으면 URL 인코딩할 것 (@ 는 %40, / 는 %2F)
# RDS가 SSL을 요구하면 ?ssl-mode=REQUIRED 를 뒤에 붙인다.
DATABASE_URL="mysql://issueboard:password@issue-board.xxxxxxxx.ap-northeast-2.rds.amazonaws.com:3306/issue_board"

# NestJS 서버 포트
PORT=4000
